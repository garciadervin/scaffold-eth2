# Template for Hardhat environment variables.
# Copy this file to .env and fill in the values.

# Alchemy API Key for chain forking and mainnet/testnet deployment (optional if using other RPC)
ALCHEMY_API_KEY=

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=

# Sepolia RPC URL (e.g. Infura or Alchemy URL)
SEPOLIA_RPC_URL=

# Deployer Private Key (starting with 0x)
DEPLOYER_PRIVATE_KEY=
